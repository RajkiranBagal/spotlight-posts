{
	"name": "spotlight-posts",
	"version": "1.0.0",
	"description": "Flag posts as featured and surface them through a Query Loop variation, a dynamic block, and a public REST endpoint.",
	"license": "GPL-2.0-or-later",
	"private": true,
	"scripts": {
		"build": "wp-scripts build && npm run build:query-loop",
		"build:query-loop": "wp-scripts build src/index.js --output-path=build/query-loop && rm -rf build/query-loop/featured-list",
		"start": "wp-scripts start"
	},
	"devDependencies": {
		"@wordpress/scripts": "^30.0.0",
		"@wordpress/server-side-render": "^5.0.0"
	}
}

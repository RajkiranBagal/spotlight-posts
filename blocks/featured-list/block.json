{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "spotlight-posts/featured-list",
	"title": "Featured Posts",
	"category": "widgets",
	"icon": "star-filled",
	"description": "Displays the posts editors have flagged as featured.",
	"keywords": [
		"featured",
		"posts",
		"spotlight"
	],
	"version": "1.0.0",
	"textdomain": "spotlight-posts",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"attributes": {
		"heading": {
			"type": "string",
			"default": ""
		},
		"numberOfPosts": {
			"type": "number",
			"default": 5
		},
		"headingLevel": {
			"type": "number",
			"default": 2
		},
		"fillWithRecent": {
			"type": "boolean",
			"default": false
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}

{
	"name": "rajkiranbagal/spotlight-posts",
	"description": "Flag posts as featured and surface them through a Query Loop variation, a dynamic block, and a public REST endpoint.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"version": "1.0.0",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"automattic/vipwpcs": "^3.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"test": "phpunit"
	}
}

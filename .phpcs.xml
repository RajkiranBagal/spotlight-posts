<?xml version="1.0"?>
<ruleset name="Spotlight Posts">
	<description>WordPress VIP Go coding standards for the Spotlight Posts plugin.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>

	<!-- Show sniff codes and progress, and report paths relative to the plugin root. -->
	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Target PHP 8.1 and newer. -->
	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.4"/>

	<rule ref="WordPress-VIP-Go"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="spotlight-posts"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="Spotlight_Posts"/>
				<element value="spotlight_posts"/>
			</property>
		</properties>
		<!--
			Tests legitimately touch WordPress's own globals, constants and hooks:
			resetting $wp_rest_server, defining DOING_AUTOSAVE to simulate an autosave,
			firing rest_api_init to boot the REST server. Prefixing those would be
			wrong, not safer.
		-->
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		Platform file-system restrictions describe VIP's runtime. The PHPUnit bootstrap
		never runs there, and needs to report setup failures to STDERR.
	-->
	<rule ref="WordPressVIPMinimum.Functions.RestrictedFunctions.file_ops_fwrite">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		Overriding a WordPress global is exactly what a test needs to do to exercise
		main-query behaviour: is_main_query() compares identity against $wp_the_query,
		so a query has to be installed as that global to be recognised as the main one.
	-->
	<rule ref="WordPress.WP.GlobalVariablesOverride.Prohibited">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>

<?xml version="1.0"?>
<ruleset name="VIP Featured Posts">
	<description>WordPress VIP Go coding standards for the VIP Featured Posts plugin.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>

	<!-- Show sniff codes and progress, and report paths relative to the plugin root. -->
	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Target PHP 8.1 and newer. -->
	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.4"/>

	<rule ref="WordPress-VIP-Go"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="vip-featured-posts"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="VIP_Featured_Posts"/>
				<element value="vip_featured_posts"/>
			</property>
		</properties>
	</rule>
</ruleset>
